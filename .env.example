# ================= ContextOS configuration =================
# Copy to .env. Anything left empty disables that feature gracefully.

# ---- who can open the Pipeline page (live stage log, queue, service status) -----------------
# Comma-separated e-mails. Everyone else does not see the tab and the server answers 403.
# In production the address must be Google-verified. Empty: in development the FIRST account created is the admin.
ADMIN_EMAILS=

# ---- core -------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://contextos:contextos_dev_password@localhost:5432/contextos
APP_ENV=development                 # development | production (production refuses to start with unsafe settings)
APP_TIMEZONE=Asia/Kolkata
# Your public HTTPS URL (ngrok, no trailing slash). Open the app through THIS url, not localhost.
PUBLIC_BASE_URL=https://YOUR-SUBDOMAIN.ngrok-free.app
# 1 behind ngrok or one load balancer (so per-IP rate limits see the real visitor). 0 = direct connection.
TRUSTED_PROXY_HOPS=1
# Generate with: python -m app.crypto   (never change after tokens are stored; rotate as NEW,OLD)
TOKEN_ENCRYPTION_KEY=
AUTO_CREATE_TABLES=true             # dev only. In production: false, and run `alembic upgrade head`
ENABLE_DEMO=                        # empty = on in development, off otherwise

# ---- sign-in ------------------------------------------------------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Authorised redirect URI:  <PUBLIC_BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Also add <PUBLIC_BASE_URL>/integrations/google-calendar/callback to the same OAuth client.
# Google Calendar permission is per-user and read-only; the assistant uses it for today's schedule.
GOOGLE_CALENDAR_REDIRECT_URI=
ALLOW_REGISTRATION=true
ALLOW_PASSWORD_AUTH=true            # false = Google only

# ---- Slack: api.slack.com/apps > your app ---------------------------------------
# Redirect URL to add under OAuth & Permissions:  <PUBLIC_BASE_URL>/integrations/slack/callback
# Event Subscriptions Request URL:                <PUBLIC_BASE_URL>/slack/events
SLACK_SIGNING_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Scopes are chosen by the permission level the user picks at connect time (essential / recommended / with_replies).
SLACK_INITIAL_SYNC_DAYS=14
SLACK_HISTORY_PAGE_SIZE=200         # set to 15 if Slack throttles your app (non-Marketplace distributed apps)
SLACK_AUTO_SYNC_MINUTES=5

# ---- AI summaries / assistant (any OpenAI-compatible API) -------------------------
# Groq (generous free tier, fast):  LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.3-70b-versatile
# Gemini (free tier):               LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   LLM_MODEL=<a Flash/Flash-Lite model>
# Free-tier limits change: set the three numbers a little UNDER what your provider console shows.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_RPM=25                          # requests per minute, all users
LLM_DAILY_CAP=900                   # requests per day, all users
LLM_USER_DAILY_CAP=150              # requests per day, per user

# ---- rate limits (defaults are sensible) ---------------------------------------------
# RL_LOGIN_IP_PER_5MIN=30
# RL_LOGIN_FAIL_LOCK_AFTER=5
# RL_REGISTER_IP_PER_HOUR=10
# RL_API_USER_PER_MIN=300

# ---- data lifecycle -----------------------------------------------------------------
RETENTION_P3_COMPACT_DAYS=7         # low-priority chatter: keep only a short snippet after this
RETENTION_P3_DELETE_DAYS=30         # ...and delete it after this
RETENTION_KEEP_DAYS=180             # P0-P2 kept this long
MAX_MESSAGES_PER_USER=50000

# ---- optional services (leave EMPTY to disable; a bare "https://" counts as empty) ------
# `docker compose up -d` starts all four with exactly these addresses. The defaults below are ON so Qdrant and Neo4j
# actually do work (search by meaning, related messages, People page, who-to-ask, collaborator boost, risk warnings).
REDIS_URL=redis://localhost:6379/0  # rate limits, caching, progress, locks. Without it limits are per-process.
QDRANT_URL=http://localhost:6333    # Qdrant Cloud: https://<cluster>.cloud.qdrant.io:6333  (+ QDRANT_API_KEY)
QDRANT_API_KEY=
QDRANT_COLLECTION=contextos_messages
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2   # 384 dims; downloaded once on first use (needs internet)
NEO4J_URI=bolt://localhost:7687     # Neo4j Aura: neo4j+s://<id>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=contextos_neo4j_pw   # must match NEO4J_PASSWORD used by docker compose (default shown). Change both for anything non-local.
NEO4J_DATABASE=neo4j
GOOGLE_CALENDAR_ENABLED=false

# ---- Gmail (read-only) uses the same GOOGLE_CLIENT_ID/SECRET -------------------------
# Google Cloud Console: enable the Gmail API and add a second Authorised redirect URI:
#   <PUBLIC_BASE_URL>/integrations/gmail/callback
# (While the OAuth consent screen is in "Testing", add your address as a test user. Gmail read scope is "restricted":
#  public launch needs Google's verification and a security assessment.)

# ---- tuning the Qdrant / Neo4j driven signals ------------------------------------------
# SEMANTIC_LINK_MIN_SCORE=0.50      # lower = more links by meaning (and more mistakes)
# SEMANTIC_SEARCH_MIN_SCORE=0.30    # Inbox search: how close in meaning a hit must be
# RELATED_MIN_SCORE=0.45            # "Related" button
# MERGE_SUGGEST_MIN_SCORE=0.80      # two project summaries this alike are offered for merging
# ESCALATION_MIN_SCORE=0.78         # a quiet message this close to an urgent one is raised
# ESCALATION_BOOST=8
# DEPENDENCY_SHARE=0.60             # one person wrote this share of a project => warning
# COLLABORATOR_MIN_PROJECTS=2
# COLLABORATOR_BOOST=10
# ---- Supabase: DATABASE_URL=postgresql+psycopg2://postgres.<ref>:<password>@<host>:5432/postgres  (direct/session mode), then enable RLS on all tables
