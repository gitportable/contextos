# ---- core -------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/contextos
APP_ENV=development            # set to "production" when deployed: disables /docs and demo data
APP_TIMEZONE=Asia/Kolkata
WORKER_POLL_SECONDS=1
# Your public HTTPS URL (ngrok). No trailing slash. Open the app through THIS url, not localhost.
# The server also refuses requests whose Host header does not match it.
PUBLIC_BASE_URL= 
ALLOW_REGISTRATION=true        # set false once your accounts exist
ADMIN_EMAIL=owner@example.com   # only this ContextOS account can access Admin
TRUST_PROXY=true               # read X-Forwarded-For (ngrok / reverse proxy). false if the app is exposed directly.

# ---- sign-in with Google (Google Cloud Console > APIs & Services > Credentials > OAuth client ID > Web) ----
# Authorized redirect URI: {PUBLIC_BASE_URL}/auth/google/callback      (leave empty to hide the button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- login protection --------------------------------------------------------
LOGIN_MAX_ATTEMPTS=5           # failed tries per (email, network) before a lockout
LOGIN_LOCKOUT_SECONDS=900      # doubles on each repeated lockout, capped at 24 h

# ---- Slack: api.slack.com/apps > Basic Information > App Credentials ---------
SLACK_SIGNING_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI= # empty = PUBLIC_BASE_URL + /integrations/slack/callback
SLACK_BOT_SCOPES=              # optional; the user-token flow needs none
# Generate with: python -m app.crypto   (never change it after tokens are stored; rotate as NEW,OLD)
TOKEN_ENCRYPTION_KEY=
SLACK_INITIAL_SYNC_DAYS=14
SLACK_HISTORY_PAGE_SIZE=200    # set 15 if Slack throttles you (commercially distributed, non-Marketplace apps)
SLACK_AUTO_SYNC_MINUTES=5
SLACK_RECONCILE_HOURS=6

# ---- LLM (free tiers). Leave both empty = extractive mode (the app still works) ----
LLM_PROVIDER=auto              # auto | groq | gemini | none
GROQ_API_KEY=
GROQ_MODEL_FAST=llama-3.1-8b-instant
GROQ_MODEL_QUALITY=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
LLM_RPM=25                     # keep below your provider's free per-minute limit (limits change: check the console)
LLM_RPD=1000                   # and below its per-day limit

# ---- projects and data lifecycle ---------------------------------------------
PROJECT_MIN_MESSAGES=3
RETAIN_P3_DAYS=30              # low-value chatter outside any project is deleted after this
RETAIN_ALL_DAYS=180

# ---- deprecated (loaded for compatibility, no longer used) ---------------------

SLACK_BOT_TOKEN=
CONTEXTOS_ADMIN_KEY=
# ---- optional integrations (leave EMPTY to disable; a bare "https://" counts as empty) ----
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=https://b843bf6e-77b0-4c2f-b839-40f8882fcc76.sa-east-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=
QDRANT_COLLECTION=contextos_messages
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_CREDENTIALS_FILE=credentials.json
GOOGLE_CALENDAR_TOKEN_FILE=token.json
GOOGLE_CALENDAR_ID=primary
